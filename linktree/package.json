{
  "name": "linktree",
  "private": true,
  "version": "0.0.0",
  "homepage": "linktree.pivi.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "prepare": "cd .. & husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "predeploygh": "pnpm run build",
    "deploygh": "gh-pages -d dist",
    "update:packages": "ncu -u",
    "depcheck": "depcheck --ignores=prettier"
  },
  "dependencies": {
    "autoprefixer": "^10.5.6",
    "floating-vue": "^5.4.0",
    "globals": "^17.12.0",
    "gsap": "^3.15.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-svg-loader": "^5.1.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{js,vue}": "eslint --fix"
  }
}
