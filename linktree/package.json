{
  "name": "linktree",
  "private": true,
  "version": "0.0.0",
  "homepage": "linktree.pivi.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "prepare": "cd .. & husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "predeploygh": "pnpm run build",
    "deploygh": "gh-pages -d dist",
    "update:packages": "ncu -u",
    "depcheck": "depcheck --ignores=prettier"
  },
  "dependencies": {
    "autoprefixer": "^10.5.4",
    "floating-vue": "^5.2.2",
    "globals": "^17.7.0",
    "gsap": "^3.15.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-qrcode": "^0.4.1",
    "vite-svg-loader": "^5.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "lint-staged": {
    "src/**/*.{js,vue,html,css}": "prettier --write",
    "src/**/*.{js,vue}": "eslint --fix"
  }
}
