{
  "name": "linktree",
  "private": true,
  "version": "1.0.1",
  "homepage": "linktree.pivi.dev",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
