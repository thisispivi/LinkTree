{
  "name": "linktree-workspace",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter linktree dev",
    "build": "pnpm --filter linktree build",
    "preview": "pnpm --filter linktree preview",
    "knip": "pnpm --filter linktree knip",
    "knip:fix": "pnpm --filter linktree knip:fix",
    "lint": "pnpm --filter linktree lint",
